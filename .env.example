# Django
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === APIs pour l'extraction de données ===

# Adzuna (offres d'emploi) — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# France Travail / Pôle Emploi — https://francetravail.io/
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Anthropic API (résumés IA + agent) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Scheduler interne (scrapes périodiques en thread).
# Laisser vide : la planification se fait par cron via scripts/update_data.sh.
# Ne mettre à 1 que sur un hébergement sans cron, ET avec un seul worker.
ENABLE_SCHEDULER=

# Notion (agent d'analyse) — https://www.notion.so/my-integrations
# Crée une intégration interne, copie le "Internal Integration Secret" (ntn_...),
# puis partage tes bases avec elle : page Notion → ••• → Connexions → ton intégration.
NOTION_API_KEY=
NOTION_VERSION=2022-06-28
